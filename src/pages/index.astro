---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import HowIWork from '../components/HowIWork.astro';
import Measured from '../components/Measured.astro';
import Timeline from '../components/Timeline.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Dock from '../components/Dock.astro';
import Palette from '../components/Palette.astro';
import { allEntries } from '../lib/work';

const entries = allEntries((await getCollection('work')).map((e) => e.data));
---
<Base>
  <Masthead slot="header" />
  <Hero entries={entries} />
  <Work entries={entries} />
  <HowIWork entries={entries} />
  <Measured entries={entries} />
  <Timeline />
  <About />
  <Contact />
  <Dock entries={entries} />
  <Palette entries={entries} />
  <script>
    import '../scripts/stage-loader';
    import '../scripts/selftest-entry';
  </script>
</Base>
