---
import type { WorkEntry } from '../lib/work-schema';
import { liveEntries } from '../lib/work';
import Icon from './Icon.astro';
import { jsonForHtml } from '../lib/json';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const data = liveEntries(entries).map((e) => ({ slug: e.slug, name: e.name, live: e.live, accent: e.accent, accentInk: e.accentInk }));
---
<div class="dock" id="dock" role="dialog" aria-modal="true" aria-label="A project running in the page" hidden>
  <div class="dock__bar">
    <span class="dock__dot" aria-hidden="true"></span>
    <b class="dock__name" data-dock-name>WardOS</b>
    <span class="dock__sp"></span>
    <a class="btn dock__btn" data-dock-open href="/" target="_blank" rel="noopener">Open in its own tab <Icon name="external" size={15} /></a>
    <button class="btn dock__btn" type="button" data-dock-close>Back to the city <Icon name="close" size={15} /></button>
  </div>
  <div class="dock__stage">
    <iframe src="about:blank" title="" allow="camera; microphone; fullscreen; autoplay" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <div class="dock__loading" data-dock-loading hidden>
      <p class="meta">Loading. The whole app starts in this tab.</p>
    </div>
    <div class="dock__fallback" data-dock-fallback hidden>
      <img data-dock-poster alt="" src="" />
      <p>This one did not start inside the page. It still runs on its own tab.</p>
      <a class="btn pri" data-dock-open-fallback href="/" target="_blank" rel="noopener">Open in its own tab</a>
    </div>
  </div>
  <script type="application/json" data-dock-entries set:html={jsonForHtml(data)} />
</div>

<script>
  import { createDock } from '../scripts/dock';
  import { SITE } from '../data/site';

  const root = document.getElementById('dock');
  if (root) {
    const entries = JSON.parse(root.querySelector('[data-dock-entries]')?.textContent ?? '[]');
    const dock = createDock({ root, entries, siteUrl: SITE.url });
    const openLink = root.querySelector<HTMLAnchorElement>('[data-dock-open]');
    const fallbackLink = root.querySelector<HTMLAnchorElement>('[data-dock-open-fallback]');
    root.addEventListener('dock:open', () => {
      if (openLink && fallbackLink) fallbackLink.href = openLink.href;
    });
    (window as unknown as { __dock?: unknown }).__dock = dock;
  }
</script>

<style>
  .dock {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--ground);
    opacity: 0;
    transition: opacity 350ms var(--ease);
  }
  .dock.open {
    opacity: 1;
  }
  .dock[hidden] {
    display: none;
  }
  .dock__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem var(--gutter-r) 0.6rem var(--gutter-l);
    padding-top: calc(0.6rem + env(safe-area-inset-top, 0px));
    border-bottom: 1px solid var(--line);
    background: var(--glass);
    font-family: var(--display);
  }
  .dock__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .dock__name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .dock__sp {
    flex: 1;
  }
  .dock__btn {
    min-height: 38px;
    padding: 0 0.9rem;
    font-size: 0.88rem;
  }
  .dock__stage {
    position: relative;
    min-height: 0;
  }
  .dock__stage iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: var(--ground);
  }
  .dock__loading,
  .dock__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 1rem;
    text-align: center;
    padding: var(--s-3);
    background: var(--ground);
  }
  .dock__loading[hidden],
  .dock__fallback[hidden] {
    display: none;
  }
  .dock__loading {
    pointer-events: none;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    animation: dockfade 300ms var(--ease) 900ms both;
  }
  @keyframes dockfade {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  .dock__fallback img {
    max-width: min(720px, 100%);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    justify-self: center;
  }
  .dock__fallback p {
    max-width: 46ch;
    justify-self: center;
  }
  .dock__fallback .btn {
    justify-self: center;
  }
  :global(body.dock-open) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .dock {
      transition: none;
    }
    .dock__loading {
      animation: none;
    }
  }
  @media (max-width: 560px) {
    .dock__btn span {
      display: none;
    }
  }
</style>
