---
import type { WorkEntry } from '../lib/work-schema';
import { liveEntries } from '../lib/work';
import snapshot from '../data/github-snapshot.json';
import type { GithubSnapshot, RepoStatus } from '../lib/github';
import { shortIsoDate } from '../lib/format';
import { jsonForHtml } from '../lib/json';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const live = liveEntries(entries);
const snap = snapshot as GithubSnapshot;
const rowFor = (slug: string): RepoStatus | undefined => snap.rows.find((r) => r.repo === slug);
const CI_WORDS: Record<RepoStatus['ci'], string> = { passing: 'tests passing', failing: 'tests failing', unknown: 'tests not run yet' };
---
<div class="gh" id="github-board" data-snapshot-date={snap.fetchedAt} data-repos={live.map((e) => e.slug).join(',')}>
  <h3>On GitHub</h3>
  <p class="meta" data-gh-caption>Snapshot taken {shortIsoDate(snap.fetchedAt)}. Live figures load when GitHub answers.</p>
  <table class="gh__table">
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">Last push</th>
        <th scope="col">Tests on GitHub</th>
        <th scope="col" class="num">Stars</th>
        <th scope="col" class="num">Open issues</th>
        <th scope="col">Licence</th>
      </tr>
    </thead>
    <tbody>
      {
        live.map((e) => {
          const r = rowFor(e.slug);
          return (
            <tr data-repo={e.slug} data-source={r ? 'snapshot' : 'none'}>
              <th scope="row"><a href={e.repo}>{e.name}</a></th>
              <td data-field="pushedAt" data-iso={r?.pushedAt ?? ''}>{r ? shortIsoDate(r.pushedAt) : '—'}</td>
              <td data-field="ci"><span class={`gh__ci gh__ci--${r?.ci ?? 'unknown'}`}>{CI_WORDS[r?.ci ?? 'unknown']}</span></td>
              <td data-field="stars" class="num">{r?.stars ?? '—'}</td>
              <td data-field="openIssues" class="num">{r?.openIssues ?? '—'}</td>
              <td data-field="licence">{r?.licence ?? '—'}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <script type="application/json" data-gh-snapshot set:html={jsonForHtml(snap.rows)} />
</div>

<script>
  import { renderBoard } from '../scripts/github-board';

  const root = document.getElementById('github-board');
  if (root) void renderBoard(root);
</script>

<style>
  .gh {
    display: grid;
    gap: 0.6rem;
  }
  .gh__table {
    margin-top: var(--s-2);
    width: 100%;
    border-collapse: collapse;
    font-family: var(--display);
    font-size: 0.92rem;
    font-stretch: 97%;
  }
  .gh__table th,
  .gh__table td {
    text-align: left;
    padding: 0.55rem 0.6rem;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .gh__table thead th {
    border-top: 0;
    color: var(--ink-2);
    font-weight: 500;
    font-size: 0.82rem;
  }
  .gh__table tbody th {
    font-weight: 500;
  }
  .gh__table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .gh__ci {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }
  .gh__ci::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .gh__ci--passing::before {
    background: var(--good);
  }
  .gh__ci--failing::before {
    background: var(--bad);
  }
  @media (max-width: 640px) {
    .gh__table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }
  }
</style>
