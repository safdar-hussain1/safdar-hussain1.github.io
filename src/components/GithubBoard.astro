---
import type { WorkEntry } from '../lib/work-schema';
import { liveEntries } from '../lib/work';
import snapshot from '../data/github-snapshot.json';
import type { GithubSnapshot, RepoStatus } from '../lib/github';
import { shortIsoDate } from '../lib/format';
import { jsonForHtml } from '../lib/json';
import Icon from './Icon.astro';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const live = liveEntries(entries);
const snap = snapshot as GithubSnapshot;
const rowFor = (slug: string): RepoStatus | undefined => snap.rows.find((r) => r.repo === slug);
const CI_WORDS: Record<RepoStatus['ci'], string> = { passing: 'tests passing', failing: 'tests failing', unknown: 'tests not run yet' };
---
<div class="gh" id="github-board" data-snapshot-date={snap.fetchedAt} data-repos={live.map((e) => e.slug).join(',')}>
  <div class="gh__head" data-reveal>
    <h3><Icon name="github" size={20} /> On GitHub</h3>
    <p class="meta" data-gh-caption>Snapshot taken {shortIsoDate(snap.fetchedAt)}. Live figures load when GitHub answers.</p>
  </div>
  <ul class="gh__grid">
    {
      live.map((e, i) => {
        const r = rowFor(e.slug);
        return (
          <li class="card card--hover gh__card" data-repo={e.slug} data-source={r ? 'snapshot' : 'none'} data-reveal data-reveal-delay={i * 50} style={`--accent:${e.accent}`}>
            <div class="gh__top">
              <a class="gh__name" href={e.repo}><span class="gh__dot" aria-hidden="true"></span>{e.name}<Icon name="external" size={13} /></a>
              <span class={`gh__ci gh__ci--${r?.ci ?? 'unknown'}`} data-field="ci"><span>{CI_WORDS[r?.ci ?? 'unknown']}</span></span>
            </div>
            <p class="gh__tag">{e.tagline}</p>
            <dl class="gh__facts">
              <div><dt>Stars</dt><dd class="num" data-field="stars">{r?.stars ?? '—'}</dd></div>
              <div><dt>Open issues</dt><dd class="num" data-field="openIssues">{r?.openIssues ?? '—'}</dd></div>
              <div><dt>Licence</dt><dd data-field="licence">{r?.licence ?? '—'}</dd></div>
              <div><dt>Last push</dt><dd data-field="pushedAt" data-iso={r?.pushedAt ?? ''}>{r ? shortIsoDate(r.pushedAt) : '—'}</dd></div>
            </dl>
          </li>
        );
      })
    }
  </ul>
  <script type="application/json" data-gh-snapshot set:html={jsonForHtml(snap.rows)} />
</div>

<script>
  import { renderBoard } from '../scripts/github-board';

  const root = document.getElementById('github-board');
  if (root) void renderBoard(root);
</script>

<style>
  .gh {
    display: grid;
    gap: 1.2rem;
  }
  .gh__head {
    display: grid;
    gap: 0.4rem;
  }
  .gh__head h3 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.3rem;
  }
  .gh__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .gh__card {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.2rem 1.3rem 1.3rem;
    font-family: var(--display);
  }
  .gh__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .gh__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .gh__name .icon {
    color: var(--ink-3);
  }
  .gh__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .gh__tag {
    font-family: var(--prose);
    color: var(--ink-2);
    font-size: 1rem;
  }
  .gh__ci {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .gh__ci::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .gh__ci--passing {
    color: var(--good);
    border-color: color-mix(in srgb, var(--good) 35%, transparent);
    background: color-mix(in srgb, var(--good) 10%, transparent);
  }
  .gh__ci--passing::before {
    background: var(--good);
  }
  .gh__ci--failing {
    color: var(--bad);
  }
  .gh__ci--failing::before {
    background: var(--bad);
  }
  .gh__facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }
  .gh__facts div {
    display: grid;
    gap: 0.15rem;
  }
  .gh__facts dt {
    font-size: 0.74rem;
    color: var(--ink-3);
  }
  .gh__facts dd {
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  @media (max-width: 420px) {
    .gh__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
