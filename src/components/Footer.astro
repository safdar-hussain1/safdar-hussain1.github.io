---
import { SITE } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="foot band">
  <div class="wrap foot__in">
    <div class="foot__brand">
      <b><span class="foot__dot" aria-hidden="true"></span>Safdar Hussain</b>
      <p>AI engineer in Hyderabad. Products that run on your own device, with the numbers behind them.</p>
      <a class="foot__top" href="#top"><Icon name="arrow-down" size={14} /> Back to the top</a>
    </div>
    <nav class="foot__col" aria-label="Footer">
      <p class="foot__head">On this page</p>
      <a href="/#projects">Projects</a>
      <a href="/#how">How I work</a>
      <a href="/#measured">Measured</a>
      <a href="/#experience">Experience</a>
      <a href="/#skills">Skills</a>
      <a href="/#practice">Practice</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
    <div class="foot__col">
      <p class="foot__head">Elsewhere</p>
      <a href={SITE.author.github}><Icon name="github" size={15} /> GitHub</a>
      <a href={SITE.author.linkedin}><Icon name="linkedin" size={15} /> LinkedIn</a>
      <a href="https://leetcode.com/u/safdar-hussain1/"><Icon name="code" size={15} /> LeetCode</a>
      <a href={`mailto:${SITE.author.email}`}><Icon name="mail" size={15} /> Email</a>
    </div>
    <div class="foot__col">
      <p class="foot__head">The site</p>
      <a href="/city/"><Icon name="cube" size={15} /> The 3D city</a>
      <a href={SITE.repo}><Icon name="git" size={15} /> Source on GitHub</a>
      <p class="foot__small">Every figure about a project is a quote from its README.</p>
    </div>
  </div>
  <div class="wrap foot__legal">
    <p class="foot__copy">© {SITE.copyrightYear} Safdar Hussain. All rights reserved.</p>
    <p class="foot__credit">Designed and built by Safdar Hussain.</p>
  </div>
  <p class="foot__mark wrap" aria-hidden="true" data-mark="Safdar Hussain"></p>
</footer>

<style>
  .foot {
    padding-block: var(--s-5) 0;
    font-family: var(--display);
    font-size: var(--step--1);
    line-height: 1.5;
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--band-ink) 12%, transparent);
  }
  .foot__in {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 820px) {
    .foot__in {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
      gap: var(--s-4);
      align-items: start;
    }
  }
  .foot__brand {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .foot__brand b {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .foot__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(120deg, #7aa2ff, #c084fc 55%, #f0abfc);
  }
  .foot__brand p {
    max-width: 34ch;
    opacity: 0.8;
  }
  .foot__top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    margin-top: 0.3rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--band-ink) 25%, transparent);
    text-decoration: none;
    color: inherit;
    font-weight: 500;
  }
  .foot__top .icon {
    transform: rotate(180deg);
  }
  .foot__top:hover {
    border-color: var(--band-ink);
    color: var(--band-ink);
  }
  .foot__col {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .foot__head {
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .foot__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: inherit;
    opacity: 0.78;
    width: fit-content;
    transition: opacity 150ms var(--ease);
  }
  .foot__col a:hover {
    opacity: 1;
    color: var(--band-ink);
  }
  .foot__small {
    margin-top: 0.4rem;
    opacity: 0.6;
    max-width: 24ch;
  }
  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: var(--s-4);
    padding-top: var(--s-2);
    border-top: 1px solid color-mix(in srgb, var(--band-ink) 12%, transparent);
    font-size: 0.85rem;
  }
  .foot__legal p {
    max-width: none;
    opacity: 0.85;
  }
  /* The name, set very large and cut by the bottom of the page: the site's signature. */
  .foot__mark::before {
    content: attr(data-mark);
  }
  .foot__mark {
    max-width: var(--max);
    margin: var(--s-3) auto -0.22em;
    font-size: clamp(3.6rem, 12.5vw, 12.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--band-ink);
    opacity: 0.07;
    user-select: none;
  }
</style>
