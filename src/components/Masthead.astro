---
import Icon from './Icon.astro';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const prefix = home ? '' : '/';
const links = [
  ['Projects', `${prefix}#projects`],
  ['Experience', `${prefix}#experience`],
  ['Skills', `${prefix}#skills`],
  ['Practice', `${prefix}#practice`],
  ['About', `${prefix}#about`],
  ['Contact', `${prefix}#contact`],
];
---
<header class="mast" slot="header">
  <div class="mast__in wrap">
    <a class="mast__wordmark" href="/"><span class="mast__mark" aria-hidden="true"></span>Safdar Hussain</a>
    <nav class="mast__nav" aria-label="Sections">
      {links.map(([label, href]) => <a href={href} data-section={href.slice(href.indexOf('#') + 1)}>{label}</a>)}
      <a class="mast__city" href="/city/" aria-label="Explore the 3D city"><Icon name="cube" size={15} /><span>3D city</span></a>
    </nav>
    <div class="mast__tools">
      <button class="mast__btn" id="palette-trigger" type="button" aria-label="Open the command palette" title="Press / anywhere">
        <Icon name="search" />
        <kbd aria-hidden="true">/</kbd>
      </button>
      <button class="mast__btn" id="sound-switch" type="button" aria-label="Sound" aria-pressed="false">
        <span class="when-off"><Icon name="sound-off" /></span>
        <span class="when-on"><Icon name="sound-on" /></span>
      </button>
      <button class="mast__btn" id="theme-switch" type="button" aria-label="Switch between the dark and the light theme">
        <span class="when-dark"><Icon name="sun" /></span>
        <span class="when-light"><Icon name="moon" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { toggleTheme } from '../scripts/theme';
  import { watchSections } from '../scripts/spy';

  document.getElementById('theme-switch')?.addEventListener('click', () => toggleTheme());
  watchSections(document.querySelectorAll<HTMLAnchorElement>('.mast__nav a[data-section]'));
</script>

<style>
  .mast {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-block: 0.6rem;
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .mast__in {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    min-height: 3rem;
  }
  .mast__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 1.05rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .mast__mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 0 4px var(--brand-soft);
  }
  .mast__nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--raised) 70%, transparent);
    font-family: var(--display);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .mast__nav a {
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
    padding: 0.42rem 0.85rem;
    border-radius: var(--radius-pill);
    transition: color 150ms var(--ease), background 150ms var(--ease);
  }
  .mast__nav a:hover,
  .mast__nav a.is-active {
    color: var(--ink);
    background: var(--raised-2);
  }
  .mast__city {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.2rem;
    color: var(--ink) !important;
    border: 1px solid var(--line-2);
  }
  .mast__city:hover {
    background: var(--raised-2) !important;
    border-color: var(--ink-3);
  }
  .mast__tools {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .mast__nav + .mast__tools {
    margin-left: 0;
  }
  .mast__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--glass);
    color: var(--ink);
    transition: border-color 150ms var(--ease);
  }
  .mast__btn:hover {
    border-color: var(--line-2);
  }
  .mast__btn kbd {
    font-family: var(--display);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .when-on,
  .when-light {
    display: none;
  }
  [aria-pressed='true'] .when-off {
    display: none;
  }
  [aria-pressed='true'] .when-on {
    display: inline;
  }
  :root[data-theme='light'] .when-dark {
    display: none;
  }
  :root[data-theme='light'] .when-light {
    display: inline;
  }
  @media (max-width: 1060px) {
    .mast__nav a:not(.mast__city) {
      display: none;
    }
    .mast__nav {
      border: 0;
      background: none;
      padding: 0;
    }
    .mast__btn kbd {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .mast__in {
      gap: 0.6rem;
    }
    .mast__wordmark {
      font-size: 0.98rem;
    }
    .mast__city {
      padding: 0;
      width: 40px;
      height: 40px;
      justify-content: center;
      margin-left: 0;
    }
    .mast__city span {
      display: none;
    }
    .mast__tools {
      gap: 0.35rem;
    }
    .mast__btn {
      min-width: 38px;
      height: 38px;
      padding: 0 0.45rem;
    }
  }
</style>
