---
import { aboutData as about } from '../lib/about';
import { longDate } from '../lib/dates';
---
<section id="about" class="about section section--ruled wrap" aria-labelledby="about-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">06</span>About</p>
    <h2 id="about-title">The person <em class="em">behind</em> the products</h2>
  </div>
  <div class="about__grid">
    <div class="about__story" data-reveal>
      {about.paragraphs.map((p, i) => <p class={i === 0 ? 'about__lede' : undefined}>{p}</p>)}
      <p class="about__outside"><b>Outside work.</b> {about.outside}</p>
      {
        about.swara && (
          <p>
            <a href={about.swara.href}>{about.swara.text}</a>
          </p>
        )
      }
    </div>
    <aside class="about__glance" data-reveal data-reveal-delay="120">
      <p class="about__now">
        <span class="pulse" aria-hidden="true"></span>
        <span><b>Building now</b> <span class="about__now-text">{longDate(about.now.date)} · {about.now.text}</span></span>
      </p>
      <dl class="about__facts">
        {
          about.facts.map((f) => (
            <div class="about__fact">
              <dt>{f.label}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--s-5);
      align-items: start;
    }
  }
  .about__story {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  .about__story > p {
    font-size: var(--step-1);
    max-width: 54ch;
    color: var(--ink-2);
  }
  .about__story > p.about__lede {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.8rem);
    line-height: 1.38;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .about__outside {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .about__outside b {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.9em;
    color: var(--ink);
  }
  .about__glance {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  .about__now {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-family: var(--display);
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.5;
    max-width: none;
  }
  .about__now .pulse {
    margin-top: 0.42rem;
  }
  .about__now b {
    color: var(--ink);
    font-weight: 600;
    margin-right: 0.25rem;
  }
  .about__facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .about__fact {
    display: grid;
    gap: 0.4rem 1.2rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  @media (min-width: 480px) {
    .about__fact {
      grid-template-columns: 110px minmax(0, 1fr);
    }
  }
  .about__fact dt {
    font-weight: 600;
    color: var(--ink);
  }
  .about__fact dd {
    margin: 0;
    color: var(--ink-2);
  }
</style>
