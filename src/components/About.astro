---
import { aboutData as about } from '../lib/about';
import { longDate } from '../lib/dates';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

const ICONS: Record<string, IconName> = { Education: 'school', Now: 'briefcase', Before: 'users', Languages: 'chat' };
const outside = about.outside.replace(/\.$/, '').split(', ');
---
<section id="about" class="about section wrap" aria-labelledby="about-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow">About</p>
    <h2 id="about-title">The person behind the products</h2>
  </div>
  <div class="about__grid">
    <div class="about__story" data-reveal>
      <p class="about__now">
        <span class="pulse" aria-hidden="true"></span>
        <b>Building now</b>
        <span class="about__now-text">{longDate(about.now.date)} · {about.now.text}</span>
      </p>
      {about.paragraphs.map((p, i) => <p class={i === 0 ? 'about__lede' : undefined}>{p}</p>)}
      <div class="about__outside">
        <h3>Outside work</h3>
        <ul class="chips">
          {outside.map((o) => <li class="chip">{o}</li>)}
        </ul>
      </div>
      {
        about.swara && (
          <p>
            <a href={about.swara.href}>{about.swara.text}</a>
          </p>
        )
      }
    </div>
    <ul class="about__facts" data-reveal data-reveal-delay="120">
      {
        about.facts.map((f) => (
          <li class="card about__fact">
            <span class="badge"><Icon name={ICONS[f.label] ?? 'spark'} size={20} /></span>
            <div>
              <b>{f.label}</b>
              <span>{f.text}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--s-5);
    }
  }
  .about__story {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  .about__story > p {
    font-size: var(--step-1);
    max-width: 54ch;
    color: var(--ink-2);
  }
  .about__story > p.about__lede {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem);
    line-height: 1.4;
    color: var(--ink);
  }
  .about__now {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    width: fit-content;
    padding: 0.5rem 1rem 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--raised) 80%, transparent);
    font-family: var(--display);
    font-size: 0.9rem !important;
    color: var(--ink-2) !important;
    max-width: none !important;
  }
  .about__now b {
    color: var(--ink);
    font-weight: 600;
  }
  .about__outside {
    display: grid;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }
  .about__outside h3 {
    font-size: 1.05rem;
  }
  .about__outside .chips {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .about__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }
  .about__fact {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.2rem;
  }
  .about__fact div {
    display: grid;
    gap: 0.25rem;
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .about__fact b {
    color: var(--ink);
    font-weight: 600;
  }
</style>
