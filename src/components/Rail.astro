---
import type { WorkEntry } from '../lib/work-schema';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
---
<nav class="rail" aria-label="Projects" hidden>
  {entries.map((e, i) => <button type="button" data-i={i} data-slug={e.slug} aria-label={`${i + 1}. ${e.name}`} aria-current="false"><span class="rail__n">{i + 1}</span><i /></button>)}
</nav>

<style>
  .rail {
    display: none;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    flex-direction: column;
    gap: 0.8rem;
    z-index: 3;
  }
  :global(.tour-on) .rail {
    display: flex;
  }
  .rail button {
    min-width: 44px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    color: var(--ink-2);
  }
  .rail__n {
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 500;
    font-stretch: 96%;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 250ms var(--ease);
  }
  .rail button.on .rail__n,
  .rail:hover .rail__n,
  .rail button:focus-visible .rail__n {
    opacity: 1;
  }
  .rail button i {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    opacity: 0.8;
    transition: width 250ms var(--ease), opacity 250ms var(--ease);
  }
  .rail button.on {
    color: var(--ink);
  }
  .rail button.on i {
    width: 34px;
    opacity: 1;
    background: var(--accent-ink);
  }
</style>
