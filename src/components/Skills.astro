---
import certificates from '../data/certificates.json';
import skills from '../data/skills.json';

// Every tool as a tile with a two-letter symbol, a row per family, the family's colour on the
// tile's top edge: a periodic table of what the products are made of.
const SYMBOLS: Record<string, string> = {
  Python: 'Py', 'scikit-learn': 'Sk', PyTorch: 'Pt', XGBoost: 'Xg', pandas: 'Pd', NumPy: 'Np', 'calibration and leakage-free evaluation': 'Ev',
  LangChain: 'Lc', LangGraph: 'Lg', 'retrieval-augmented generation': 'Rg', Ollama: 'Ol', 'Hugging Face Transformers': 'Hf',
  OpenCV: 'Cv', YOLO: 'Yo', MediaPipe: 'Mp', 'ONNX Runtime': 'Ox', WebGL: 'Gl',
  TypeScript: 'Ts', React: 'Re', Astro: 'As', 'Three.js': 'Tj', 'SQLite in the browser': 'Sq', Vitest: 'Vt',
  FastAPI: 'Fa', PostgreSQL: 'Pg', 'Node.js': 'Nd', Docker: 'Dk', AWS: 'Aw', 'GitHub Actions': 'Ga', Java: 'Jv',
};
const FAMILY: Record<string, string> = { 'Machine learning': 'ml', 'Language models': 'llm', 'Computer vision': 'cv', Web: 'web', 'Backend and cloud': 'cloud' };
const symbol = (name: string) => SYMBOLS[name] ?? name.slice(0, 1).toUpperCase() + name.slice(1, 2).toLowerCase();
---
<section id="skills" class="skills section section--ruled wrap" aria-labelledby="skills-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">05</span>Skills</p>
    <h2 id="skills-title">What I <em class="em">build</em> with</h2>
    <p class="sec__lede">The tools behind the products above, one tile each, grouped by the work they do.</p>
  </div>
  <div class="skills__grid">
    <ol class="rows skills__table" data-reveal>
      {
        skills.map((g, gi) => (
          <li class="skills__row" style={`--family:var(--g-${FAMILY[g.name] ?? 'ml'})`}>
            <h3 class="skills__name"><span class="skills__swatch" aria-hidden="true"></span>{g.name}</h3>
            <ul class="skills__tiles">
              {g.items.map((item, k) => (
                <li class="tile" style={`--k:${gi * 7 + k}`}>
                  <b aria-hidden="true">{symbol(item)}</b>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
    <aside class="skills__certs" data-reveal data-reveal-delay="120">
      <h3>Certificates</h3>
      <ol class="rows">
        {
          certificates.map((c) => (
            <li class="skills__cert">
              <b>{c.name}</b>
              {c.issuer && <span class="meta">{c.issuer}</span>}
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 980px) {
    .skills__grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: var(--s-5);
      align-items: start;
    }
  }
  .skills__row {
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 0 1.2rem;
  }
  @media (min-width: 640px) {
    .skills__row {
      grid-template-columns: 170px minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
  }
  .skills__name {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    padding-top: 0.5rem;
  }
  .skills__swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--family);
  }
  .skills__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 0.5rem;
  }
  .tile {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 0.4rem;
    min-height: 82px;
    padding: 0.6rem 0.65rem 0.55rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--family);
    border-radius: 10px;
    background: var(--raised);
    font-family: var(--display);
    transition: transform 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease);
  }
  .tile:hover {
    transform: translateY(-2px);
    border-color: var(--family);
    box-shadow: var(--shadow-2);
  }
  .tile b {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }
  .tile span {
    font-size: 0.7rem;
    line-height: 1.25;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .skills__certs {
    display: grid;
    gap: 0.8rem;
  }
  .skills__certs > h3 {
    font-size: 1.02rem;
  }
  .skills__cert {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 0;
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .skills__cert b {
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
  }
</style>
