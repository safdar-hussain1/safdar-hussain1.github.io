---
import type { WorkEntry } from '../lib/work-schema';
import certificates from '../data/certificates.json';
import skills from '../data/skills.json';

// Three honest tiers, in his own grading: what he could teach, what he uses every week, and
// what he has shipped with. The first tier points at the products on this page that prove it.
interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const byslug = (slug: string) => entries.find((e) => e.slug === slug && e.status === 'live');
---
<section id="skills" class="skills section band band--2" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="sec__head" data-reveal>
      <p class="eyebrow"><span class="eyebrow__n">05</span>Skills</p>
      <h2 id="skills-title">What I <em class="em">build</em> with</h2>
      <p class="sec__lede">Graded the way I would grade myself: what I could teach, what I use every week, and what I have shipped with.</p>
    </div>

    <div class="skills__tier" data-reveal>
      <div class="skills__tierhead">
        <h3>Could teach</h3>
        <p class="meta">The four I know deepest, each with the product on this page that proves it.</p>
      </div>
      <ol class="skills__teach">
        {
          skills.teach.map((s, i) => (
            <li class="card skills__teachcard" style={`--i:${i}`}>
              <span class="skills__n" aria-hidden="true">0{i + 1}</span>
              <h4>{s.name}</h4>
              <p>{s.line}</p>
              {s.proof.length > 0 && (
                <p class="skills__proof">
                  {s.proof.map(byslug).filter(Boolean).map((e) => (
                    <a href={`/work/${e!.slug}/`} style={`--accent:${e!.accent}`}><span class="skills__dot" aria-hidden="true"></span>{e!.name}</a>
                  ))}
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="skills__tier" data-reveal data-reveal-delay="80">
      <div class="skills__tierhead">
        <h3>Every week</h3>
        <p class="meta">The stack of the day job, in production.</p>
      </div>
      <ol class="skills__weekly">
        {
          skills.weekly.map((g) => (
            <li class="skills__group">
              <h4>{g.name}</h4>
              <ul class="chips">
                {g.items.map((item) => (
                  <li class="chip chip--plain">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="skills__tier skills__tier--last" data-reveal data-reveal-delay="140">
      <div class="skills__tierhead">
        <h3>Have shipped with</h3>
        <p class="meta">On the resume, used in a product, not a specialism.</p>
      </div>
      <div class="skills__also">
        <ul class="chips">
          {skills.also.map((item) => <li class="chip chip--plain chip--quiet">{item}</li>)}
        </ul>
        <div class="skills__certs">
          <h4>Certificates</h4>
          <ol class="rows">
            {
              certificates.map((c) => (
                <li class="skills__cert">
                  <b>{c.name}</b>
                  {c.issuer && <span class="meta">{c.issuer}</span>}
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    margin-top: var(--s-6);
    padding-block: var(--s-5) var(--s-5);
  }
  .skills__tier {
    display: grid;
    gap: 1.2rem;
    padding: var(--s-3) 0 var(--s-4);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .skills__tier {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--s-4);
      align-items: start;
    }
  }
  .skills__tierhead {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .skills__tierhead h3 {
    font-size: 1.25rem;
  }
  .skills__tierhead .meta {
    max-width: 24ch;
  }
  .skills__teach {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.9rem;
  }
  .skills__teachcard {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.2rem 1.2rem 1.25rem;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  .skills__teachcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .skills__n {
    font-family: var(--display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand-ink);
    font-variant-numeric: tabular-nums;
  }
  .skills__teachcard h4 {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
  }
  .skills__teachcard p {
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .skills__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    margin-top: 0.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-family: var(--display);
    font-size: 0.84rem !important;
    font-weight: 600;
  }
  .skills__proof a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink);
  }
  .skills__proof a:hover {
    color: var(--accent-ink);
  }
  .skills__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .skills__weekly {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem 1.5rem;
  }
  .skills__group {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 0.9rem 0;
  }
  .skills__group h4 {
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }
  .skills__group .chips,
  .skills__also .chips {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills__also {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 980px) {
    .skills__also {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--s-4);
      align-items: start;
    }
  }
  .chip--quiet {
    background: transparent;
  }
  .skills__certs {
    display: grid;
    gap: 0.5rem;
  }
  .skills__certs h4 {
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }
  .skills__cert {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0;
    font-family: var(--display);
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .skills__cert b {
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .skills__teachcard {
      transition: none;
    }
  }
</style>
