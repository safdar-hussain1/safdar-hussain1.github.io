---
import certificates from '../data/certificates.json';
import skills from '../data/skills.json';
---
<section id="skills" class="skills section section--ruled wrap" aria-labelledby="skills-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">05</span>Skills</p>
    <h2 id="skills-title">What I <em class="em">build</em> with</h2>
    <p class="sec__lede">The tools behind the products above, grouped by the work they do.</p>
  </div>
  <div class="skills__grid">
    <ol class="rows skills__table" data-reveal>
      {
        skills.map((g) => (
          <li class="skills__row">
            <h3 class="skills__name">{g.name}</h3>
            <ul class="chips">
              {g.items.map((item) => (
                <li class="chip chip--plain">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
    <aside class="skills__certs" data-reveal data-reveal-delay="120">
      <h3>Certificates</h3>
      <ol class="rows">
        {
          certificates.map((c) => (
            <li class="skills__cert">
              <b>{c.name}</b>
              {c.issuer && <span class="meta">{c.issuer}</span>}
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 980px) {
    .skills__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--s-5);
      align-items: start;
    }
  }
  .skills__row {
    display: grid;
    gap: 0.8rem;
    padding: 1.1rem 0 1.2rem;
  }
  @media (min-width: 640px) {
    .skills__row {
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
  }
  .skills__name {
    font-size: 1.02rem;
    padding-top: 0.3rem;
  }
  .skills__row .chips {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills__certs {
    display: grid;
    gap: 0.8rem;
  }
  .skills__certs > h3 {
    font-size: 1.02rem;
  }
  .skills__cert {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 0;
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .skills__cert b {
    font-weight: 600;
  }
</style>
