---
import type { WorkEntry } from '../lib/work-schema';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const fact = (slug: string, i: number) => {
  const e = entries.find((x) => x.slug === slug)!;
  return { ...e.facts[i], name: e.name, accent: e.accent, accentInk: e.accentInk };
};
const principles = [
  {
    title: 'Measure, don’t claim',
    text: 'Every product is scored against the naive thing people actually do, and the number is on the page.',
    proof: fact('homecast', 2),
  },
  {
    title: 'Break it on purpose',
    text: 'Each headline claim has a test that goes red when the mechanism behind it is removed.',
    proof: fact('red-light-green-light-cv', 1),
  },
  {
    title: 'Publish the bad number',
    text: 'A fix that did not help stays in the report, next to the ones that did.',
    proof: fact('nightingale', 3),
  },
  {
    title: 'It runs on your device',
    text: 'No server anywhere. The model you read about is the model that runs, and nothing you load leaves the tab.',
    proof: fact('wardos', 0),
  },
];
---
<section id="how" class="how section section--ruled wrap" aria-labelledby="how-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">02</span>How I work</p>
    <h2 id="how-title">Four rules, each with a <em class="em">number</em> behind it</h2>
    <p class="sec__lede">Every rule links to the line of a README that proves it was followed.</p>
  </div>
  <ol class="how__list">
    {
      principles.map((p, i) => (
        <li class="how__item" data-reveal data-reveal-delay={i * 70} style={`--accent:${p.proof.accent};--accent-ink:${p.proof.accentInk.dark};--accent-ink-light:${p.proof.accentInk.light}`}>
          <span class="how__n" aria-hidden="true">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p class="how__text">{p.text}</p>
          <p class="how__proof">
            <span class="how__who"><span class="how__dot" aria-hidden="true"></span>{p.proof.name}</span>
            <a href={p.proof.source}>{p.proof.text}</a>
          </p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .how__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0 var(--s-3);
    border-top: 1px solid var(--line);
  }
  .how__item {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.4rem 0 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .how__item + .how__item {
      border-left: 1px solid var(--line);
      padding-left: var(--s-3);
      margin-left: calc(-1 * var(--s-3) / 2);
    }
  }
  .how__n {
    font-family: var(--display);
    font-size: 2.4rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .how__item h3 {
    font-size: 1.2rem;
    margin-top: 0.3rem;
  }
  .how__text {
    color: var(--ink-2);
    font-size: 1rem;
  }
  .how__proof {
    display: grid;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--display);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .how__who {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .how__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .how__proof a {
    color: var(--ink);
    text-decoration-color: var(--line-2);
  }
  .how__proof a:hover {
    color: var(--accent-ink);
  }
  :root[data-theme='light'] .how__proof a:hover {
    color: var(--accent-ink-light);
  }
</style>
