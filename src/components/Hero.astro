---
import type { WorkEntry } from '../lib/work-schema';
import Icon from './Icon.astro';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
// The flat hero shows a picture of the city; where the city itself runs, the picture gives way
// to it. The alt names what the picture is of without listing the projects (the cards do that).
const stillAlt = `A small night city on a round plinth: ${entries.length} buildings along one road, each with a lit screen on its facade`;
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title">Safdar Hussain</h1>
    <div class="hero__copy">
      <p class="hero__line">I build products that run on your own device and publish the numbers behind them.</p>
      <a class="hero__cue meta" href="#work">
        <Icon name="arrow-down" size={16} />
        Every project runs live. Scroll.
      </a>
    </div>
  </div>
  <div id="hero-art" class="hero__art">
    <img
      class="hero__still"
      src="/hero-still-sm.webp"
      srcset="/hero-still-sm.webp 800w, /hero-still.webp 1600w"
      sizes="(min-width: 900px) 56vw, 100vw"
      width="1600"
      height="1000"
      fetchpriority="high"
      decoding="async"
      alt={stillAlt}
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--s-3);
    min-height: min(78vh, 760px);
    align-content: end;
    padding-block: var(--s-5) var(--s-4);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
      align-items: end;
      gap: var(--s-4);
    }
  }
  .hero__text,
  .hero__copy {
    display: grid;
    gap: var(--s-2);
    max-width: 30ch;
  }
  .hero__line {
    font-size: clamp(1.2rem, 1rem + 1.1vw, 1.55rem);
    line-height: 1.4;
    max-width: 34ch;
  }
  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    text-decoration: none;
    margin-top: var(--s-1);
  }
  .hero__cue:hover {
    color: var(--ink);
  }
  .hero__art {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--raised);
    box-shadow: var(--shadow);
  }
  .hero__still {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
