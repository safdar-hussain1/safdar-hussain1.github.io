---
import type { WorkEntry } from '../lib/work-schema';
import { liveEntries } from '../lib/work';
import WorkCard from './WorkCard.astro';
import Rail from './Rail.astro';
import { jsonForHtml } from '../lib/json';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const live = liveEntries(entries);
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const liveWord = WORDS[live.length] ?? String(live.length);
// The city needs every entry, scenery included: one building each.
const stageEntries = entries.map((e) => ({ slug: e.slug, name: e.name, building: e.building, accent: e.accent, accentInk: e.accentInk, status: e.status, tagline: e.tagline }));
---
<section id="projects" class="work section wrap" aria-labelledby="projects-title" style={`--stops:${live.length}`}>
  <div class="work__head sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">01</span>Projects</p>
    <h2 id="projects-title">{liveWord} products, each one running live</h2>
    <p class="work__lede sec__lede">Each one is a complete product that runs on your own device. On a desktop, <em>Use it here</em> opens it inside this page.</p>
  </div>
  <div class="work__list">
    {live.map((e, i) => <WorkCard entry={e} index={i} total={live.length} />)}
  </div>
  <Rail entries={live} />
  <script type="application/json" data-stage-entries set:html={jsonForHtml(stageEntries)} />
</section>

<script>
  import { watchLoops } from '../scripts/loops';

  watchLoops(document.getElementById('work') ?? document);
</script>

<style>
  .work {
    position: relative;
  }
  .work__lede em {
    font-style: normal;
    font-family: var(--display);
    font-size: 0.9em;
    font-weight: 600;
    color: var(--ink);
  }
</style>
