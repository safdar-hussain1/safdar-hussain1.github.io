---
import type { WorkEntry } from '../lib/work-schema';
import { liveEntries } from '../lib/work';
import WorkCard from './WorkCard.astro';
import Rail from './Rail.astro';

interface Props {
  entries: WorkEntry[];
}
const { entries } = Astro.props;
const live = liveEntries(entries);
---
<section id="work" class="work section wrap" aria-labelledby="work-title">
  <div class="work__head">
    <h2 id="work-title">Work</h2>
    <p class="work__lede">Each one is a complete product. Press <em>Use it here</em> and it runs on this page.</p>
  </div>
  <div class="work__list">
    {entries.map((e, i) => <WorkCard entry={e} index={i} total={entries.length} />)}
  </div>
  <Rail entries={live} />
</section>

<script>
  import { watchLoops } from '../scripts/loops';

  watchLoops(document.getElementById('work') ?? document);
</script>

<style>
  .work {
    position: relative;
  }
  .work__head {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
  }
  .work__lede {
    font-size: var(--step-1);
    max-width: 44ch;
  }
  .work__lede em {
    font-style: normal;
    font-family: var(--display);
    font-size: 0.9em;
    font-weight: 600;
  }
</style>
