---
import timeline from '../data/timeline.json';
import { aboutData as about } from '../lib/about';
import { shortDate } from '../lib/dates';

// A CV, newest first, under a chart of the same years: the degree as the long bar, the roles
// and the club as bars over it, the talk as a point, the job now running to the present.
type Kind = 'work' | 'education' | 'community' | 'talk';
const KINDS: Record<Kind, string> = { work: 'Work', education: 'Education', community: 'Community', talk: 'Talk' };
type Item = { when: string; until?: string; ongoing?: boolean; kind: Kind; title: string; role: string; text: string; points?: string[] };
const all = timeline as Item[];
const items = [...all].reverse();
const span = (t: Item) => shortDate(t.when) + (t.until ? ` – ${shortDate(t.until)}` : t.ongoing ? ' – now' : '');

// The chart. Years run left to right; a month is a twelfth; a bare year sits at its middle.
const toYear = (w: string) => {
  const [y, m] = w.split('-');
  return Number(y) + (m ? (Number(m) - 1) / 12 : 0.5);
};
const NOW = toYear(about.now.date) + 1 / 24;
const edu = all.filter((t) => t.kind === 'education');
type Row = { label: string; kind: Kind; from: number; to: number | null; ongoing?: boolean; note?: string };
const degree: Row = { label: 'B.Tech, Mahindra University', kind: 'education', from: toYear(edu[0].when), to: toYear(edu[edu.length - 1].when), note: 'graduated' };
const rows: Row[] = [
  degree,
  ...all.filter((t) => t.kind !== 'education').map((t): Row => ({ label: `${t.title.replace(', Mahindra University', '')}, ${t.role}`, kind: t.kind, from: toYear(t.when), to: t.until ? toYear(t.until) : t.ongoing ? NOW : null, ongoing: Boolean(t.ongoing) })),
].sort((a, b) => a.from - b.from);
const X0 = 2022.5;
const X1 = 2027;
const LX = 262;
const W = 1000;
const ROW = 30;
const TOP = 34;
const H = TOP + rows.length * ROW + 6;
const px = (t: number) => LX + ((t - X0) / (X1 - X0)) * (W - LX);
const years = [2023, 2024, 2025, 2026];
const KIND_FILL: Record<Kind, string> = { work: 'var(--brand)', education: 'var(--ink-3)', community: 'var(--g-llm)', talk: 'var(--ink-2)' };
const chartLabel = `A chart of the same years: ${rows.map((r) => r.label).join('; ')}.`;
---
<section id="experience" class="exp section section--ruled wrap" aria-labelledby="experience-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">04</span>Experience</p>
    <h2 id="experience-title">Where I have <em class="em">been</em></h2>
    <p class="sec__lede">From the first year of the degree to the job I do now, with the work in between. Two of the roles ran alongside the degree, and for a while alongside each other.</p>
  </div>
  <figure class="exp__chart" data-reveal>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={chartLabel}>
      {years.map((y) => (
        <g>
          <line class="exp__grid" x1={px(y)} x2={px(y)} y1={TOP - 10} y2={H - 4} />
          <text class="exp__year" x={px(y)} y={14} text-anchor="middle">{y}</text>
        </g>
      ))}
      <line class="exp__now" x1={px(NOW)} x2={px(NOW)} y1={TOP - 10} y2={H - 4} />
      <text class="exp__nowlabel" x={px(NOW) + 6} y={14}>now</text>
      {
        rows.map((r, i) => {
          const y = TOP + i * ROW;
          const x0 = px(r.from);
          const x1 = r.to === null ? x0 : px(r.to);
          return (
            <g class={`exp__r exp__r--${r.kind}`} style={`--i:${i}`}>
              <text class="exp__label" x={LX - 14} y={y + 15} text-anchor="end">{r.label}</text>
              {r.to === null ? (
                <polygon class="exp__point" points={`${x0},${y + 3} ${x0 + 8},${y + 11} ${x0},${y + 19} ${x0 - 8},${y + 11}`} style={`fill:${KIND_FILL[r.kind]}`} />
              ) : (
                <rect class={`exp__bar${r.ongoing ? ' exp__bar--on' : ''}`} x={x0} y={y + 4} width={Math.max(10, x1 - x0)} height={14} rx={7} style={`fill:${KIND_FILL[r.kind]}`} />
              )}
              {r.ongoing && <polygon class="exp__arrow" points={`${x1 - 2},${y + 2} ${x1 + 8},${y + 11} ${x1 - 2},${y + 20}`} style={`fill:${KIND_FILL[r.kind]}`} />}
              {r.note && <text class="exp__note" x={x1 - 4} y={y} text-anchor="end">{r.note}</text>}
            </g>
          );
        })
      }
    </svg>
    <figcaption class="meta">Bars are the roles and the degree; the diamond is the poster; the arrow runs to today.</figcaption>
  </figure>
  <ol class="rows exp__list">
    {
      items.map((t, i) => (
        <li class={`exp__row exp__row--${t.kind}${t.ongoing ? ' exp__row--now' : ''}`} data-reveal data-reveal-delay={i * 40}>
          <div class="exp__when">
            <span class="exp__dates">{t.ongoing && <span class="pulse" aria-hidden="true" />}{span(t)}</span>
            <span class="exp__kind">{KINDS[t.kind]}</span>
          </div>
          <div class="exp__body">
            <h3>{t.title}</h3>
            <p class="exp__role">{t.role}</p>
            <p class="exp__text">{t.text}</p>
            {t.points && (
              <ul class="exp__points">
                {t.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .exp__chart {
    margin: 0 0 var(--s-4);
    display: grid;
    gap: 0.6rem;
  }
  .exp__chart svg {
    width: 100%;
    height: auto;
    font-family: var(--display);
    overflow: visible;
  }
  .exp__grid {
    stroke: var(--line-2);
    stroke-width: 1;
  }
  .exp__year,
  .exp__label,
  .exp__note,
  .exp__nowlabel {
    font-size: 13px;
    fill: var(--ink-2);
  }
  .exp__year {
    font-weight: 600;
    fill: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .exp__nowlabel {
    font-weight: 600;
    fill: var(--brand-ink);
  }
  .exp__now {
    stroke: var(--brand-ink);
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }
  .exp__label {
    font-weight: 500;
  }
  .exp__note {
    fill: var(--ink-3);
    font-style: italic;
    font-family: var(--prose);
    font-size: 14px;
  }
  .exp__bar {
    opacity: 0.95;
    transform-origin: left center;
    transform: scaleX(0);
  }
  .exp__r--education .exp__bar {
    opacity: 0.35;
  }
  .in .exp__bar {
    animation: bar 1100ms var(--ease) forwards;
    animation-delay: calc(120ms + var(--i) * 90ms);
  }
  @keyframes bar {
    to {
      transform: scaleX(1);
    }
  }
  .exp__point,
  .exp__arrow {
    opacity: 0;
  }
  .in .exp__point,
  .in .exp__arrow {
    animation: appear 500ms var(--ease) forwards;
    animation-delay: calc(900ms + var(--i) * 90ms);
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @media (max-width: 820px) {
    .exp__chart {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .exp__bar {
      transform: none;
    }
    .exp__point,
    .exp__arrow {
      opacity: 1;
    }
    .in .exp__bar,
    .in .exp__point,
    .in .exp__arrow {
      animation: none;
    }
  }
  .exp__row {
    display: grid;
    gap: 0.6rem 2rem;
    padding: 1.4rem 0 1.6rem;
  }
  @media (min-width: 820px) {
    .exp__row {
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: start;
    }
  }
  .exp__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-family: var(--display);
  }
  @media (min-width: 820px) {
    .exp__when {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0.25rem;
    }
  }
  .exp__dates {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .exp__kind {
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .exp__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .exp__body h3 {
    font-size: 1.3rem;
  }
  .exp__role {
    font-family: var(--display);
    font-weight: 500;
    color: var(--brand-ink);
    font-size: 0.98rem;
  }
  .exp__text {
    color: var(--ink-2);
    max-width: 62ch;
    margin-top: 0.25rem;
  }
  .exp__points {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .exp__points li {
    position: relative;
    padding-left: 1.2rem;
  }
  .exp__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.55rem;
    height: 1px;
    background: var(--ink-3);
  }
</style>
