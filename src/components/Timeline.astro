---
import timeline from '../data/timeline.json';
import { shortDate } from '../lib/dates';

// A CV, newest first: dates on the left, the entry on the right, a hairline between rows.
type Kind = 'work' | 'education' | 'community' | 'talk';
const KINDS: Record<Kind, string> = { work: 'Work', education: 'Education', community: 'Community', talk: 'Talk' };
type Item = { when: string; until?: string; ongoing?: boolean; kind: Kind; title: string; role: string; text: string; points?: string[] };
const items = [...(timeline as Item[])].reverse();
const span = (t: Item) => shortDate(t.when) + (t.until ? ` – ${shortDate(t.until)}` : t.ongoing ? ' – now' : '');
---
<section id="experience" class="exp section section--ruled wrap" aria-labelledby="experience-title">
  <div class="sec__head" data-reveal>
    <p class="eyebrow"><span class="eyebrow__n">04</span>Experience</p>
    <h2 id="experience-title">Where I have <em class="em">been</em></h2>
    <p class="sec__lede">From the first year of the degree to the job I do now, with the work in between.</p>
  </div>
  <ol class="rows exp__list">
    {
      items.map((t, i) => (
        <li class={`exp__row exp__row--${t.kind}${t.ongoing ? ' exp__row--now' : ''}`} data-reveal data-reveal-delay={i * 40}>
          <div class="exp__when">
            <span class="exp__dates">{t.ongoing && <span class="pulse" aria-hidden="true" />}{span(t)}</span>
            <span class="exp__kind">{KINDS[t.kind]}</span>
          </div>
          <div class="exp__body">
            <h3>{t.title}</h3>
            <p class="exp__role">{t.role}</p>
            <p class="exp__text">{t.text}</p>
            {t.points && (
              <ul class="exp__points">
                {t.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .exp__row {
    display: grid;
    gap: 0.6rem 2rem;
    padding: 1.4rem 0 1.6rem;
  }
  @media (min-width: 820px) {
    .exp__row {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
    }
  }
  .exp__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-family: var(--display);
  }
  @media (min-width: 820px) {
    .exp__when {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0.25rem;
    }
  }
  .exp__dates {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .exp__kind {
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  :root[data-theme='light'] .exp__kind {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    border: 1px solid var(--chip-line);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .exp__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .exp__body h3 {
    font-size: 1.3rem;
  }
  .exp__role {
    font-family: var(--display);
    font-weight: 500;
    color: var(--brand-ink);
    font-size: 0.98rem;
  }
  .exp__text {
    color: var(--ink-2);
    max-width: 62ch;
    margin-top: 0.25rem;
  }
  .exp__points {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .exp__points li {
    position: relative;
    padding-left: 1.2rem;
  }
  .exp__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.55rem;
    height: 1px;
    background: var(--ink-3);
  }
</style>
