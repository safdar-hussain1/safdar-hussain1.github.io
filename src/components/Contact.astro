---
import { SITE } from '../data/site';
import Icon from './Icon.astro';
---
<section id="contact" class="contact section band" aria-labelledby="contact-title">
  <div class="wrap contact__in">
    <div class="contact__head" data-reveal>
      <p class="eyebrow"><span class="eyebrow__n">07</span>Contact</p>
      <h2 id="contact-title">Let's build something that runs on <em class="em">your device</em>.</h2>
      <p class="contact__lede">Whether it is a role, a contract or a question about one of the products, write to me. Email is best; I read it every day.</p>
      <dl class="contact__details">
        <div>
          <dt><Icon name="mail" size={16} /> Email</dt>
          <dd>
            <a class="contact__mail" href={`mailto:${SITE.author.email}`}><code id="contact-email">{SITE.author.email}</code></a>
            <button class="contact__copy" type="button" id="copy-email" aria-label="Copy the email address"><Icon name="copy" size={15} /><span>Copy</span></button>
          </dd>
        </div>
        <div>
          <dt><Icon name="pin" size={16} /> Based in</dt>
          <dd>Hyderabad, India. I work remotely, on Indian Standard Time.</dd>
        </div>
        <div>
          <dt><Icon name="git" size={16} /> Elsewhere</dt>
          <dd class="contact__links">
            <a href={SITE.author.github}><Icon name="github" size={16} /> GitHub</a>
            <a href={SITE.author.linkedin}><Icon name="linkedin" size={16} /> LinkedIn</a>
          </dd>
        </div>
      </dl>
    </div>
    <form class="contact__form" action={`mailto:${SITE.author.email}`} method="post" enctype="text/plain" data-contact-form data-reveal data-reveal-delay="120">
      <p class="contact__form-title">Send a message</p>
      <div class="contact__fields">
        <label><span>Your name</span><input type="text" name="name" autocomplete="name" required /></label>
        <label><span>Your email</span><input type="email" name="email" autocomplete="email" required /></label>
        <label class="contact__wide"><span>Message</span><textarea name="message" rows="5" required placeholder="What are you building, and where could I help?"></textarea></label>
      </div>
      <div class="contact__send">
        <button class="btn cta" type="submit">Send message <Icon name="arrow-right" size={16} /></button>
        <p class="contact__note meta" data-form-note>Opens in your mail app, addressed to me. Nothing is stored here.</p>
      </div>
    </form>
  </div>
</section>

<script>
  import { copyText } from '../scripts/copy';
  import { mountContactForm } from '../scripts/contact-form';
  import { SITE } from '../data/site';

  const btn = document.getElementById('copy-email');
  const code = document.getElementById('contact-email');
  btn?.addEventListener('click', async () => {
    const ok = await copyText(code?.textContent?.trim() ?? '', code ?? undefined);
    const label = btn.querySelector('span');
    if (label) label.textContent = ok ? 'Copied' : 'Selected';
    setTimeout(() => {
      if (label) label.textContent = 'Copy';
    }, 1600);
  });
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) mountContactForm(form, SITE.author.email);
</script>

<style>
  .contact {
    margin-top: var(--s-6);
    padding-block: var(--s-6);
  }
  .contact__in {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 980px) {
    .contact__in {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--s-6);
      align-items: start;
    }
  }
  .contact__head {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  .contact__head .eyebrow {
    color: var(--band-ink);
    opacity: 0.75;
  }
  .contact__head h2 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.3rem);
    max-width: 16ch;
  }
  .contact__lede {
    font-size: var(--step-1);
    opacity: 0.85;
    max-width: 44ch;
  }
  .contact__details {
    margin: 0.6rem 0 0;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  .contact__details > div {
    display: grid;
    gap: 0.4rem 1.2rem;
    padding: 1rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    font-family: var(--display);
  }
  @media (min-width: 560px) {
    .contact__details > div {
      grid-template-columns: 130px minmax(0, 1fr);
      align-items: center;
    }
  }
  .contact__details dt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    opacity: 0.85;
  }
  .contact__details dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    font-size: 1rem;
  }
  .contact__mail {
    text-decoration: none;
    color: inherit;
  }
  .contact__mail code {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    user-select: all;
  }
  .contact__mail:hover code {
    text-decoration-color: currentColor;
  }
  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    font-family: var(--display);
    font-size: 0.82rem;
    font-weight: 600;
    color: inherit;
  }
  .contact__copy:hover {
    border-color: currentColor;
  }
  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 500;
    color: inherit;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  }
  .contact__links a:hover {
    border-bottom-color: currentColor;
  }
  .contact__form {
    display: grid;
    gap: 1.2rem;
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    background: color-mix(in srgb, var(--ground) 55%, transparent);
  }
  .contact__form-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.15rem;
  }
  .contact__fields {
    display: grid;
    gap: 0.9rem;
  }
  @media (min-width: 560px) {
    .contact__fields {
      grid-template-columns: 1fr 1fr;
    }
    .contact__wide {
      grid-column: 1 / -1;
    }
  }
  .contact__fields label {
    display: grid;
    gap: 0.4rem;
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 500;
    opacity: 0.9;
  }
  .contact__fields input,
  .contact__fields textarea {
    font: inherit;
    font-family: var(--display);
    font-size: 0.98rem;
    color: inherit;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    background: color-mix(in srgb, var(--ground) 70%, transparent);
    transition: border-color 150ms var(--ease);
  }
  .contact__fields textarea::placeholder,
  .contact__fields input::placeholder {
    color: inherit;
    opacity: 0.45;
  }
  .contact__fields textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .contact__fields input:focus,
  .contact__fields textarea:focus {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-color: transparent;
  }
  .contact__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .contact__note {
    color: inherit;
    opacity: 0.7;
    max-width: 30ch;
  }
</style>
