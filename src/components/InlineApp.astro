---
import type { WorkEntry } from '../lib/work-schema';
import Icon from './Icon.astro';
import { framePath } from '../lib/url';
import { SITE } from '../data/site';

interface Props {
  entry: WorkEntry;
}
const { entry: e } = Astro.props;
---
<section class="app" data-inline-app data-live={e.live} data-frame={framePath(e.live, SITE.url)} data-name={e.name} style={`--accent:${e.accent};--accent-ink:${e.accentInk.dark};--accent-ink-light:${e.accentInk.light}`}>
  <div class="app__bar">
    <span class="app__dot" aria-hidden="true"></span>
    <b>{e.name}, running in this page</b>
    <span class="app__sp"></span>
    <a class="btn app__btn" href={e.live} target="_blank" rel="noopener">Open in its own tab <Icon name="external" size={15} /></a>
  </div>
  <div class="app__stage" data-app-stage>
    <div class="app__poster" data-app-poster>
      <img src={`/work/${e.slug}/poster.webp`} alt={`${e.name} as it opens`} width="1600" height="1000" loading="eager" />
      <a class="btn pri app__open" href={e.live}>Open {e.name}</a>
      <p class="app__note meta" data-app-note hidden>It did not start inside this page. It runs on its own tab.</p>
    </div>
  </div>
</section>

<script>
  import { mountInlineApps } from '../scripts/inline-app';

  mountInlineApps();
</script>

<style>
  .app {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--raised);
    box-shadow: var(--shadow);
  }
  .app__bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--glass);
    font-family: var(--display);
    font-size: 0.9rem;
  }
  .app__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .app__sp {
    flex: 1;
  }
  .app__btn {
    min-height: 36px;
    padding: 0 0.8rem;
    font-size: 0.85rem;
  }
  .app__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 82vh;
  }
  .app__stage--live {
    aspect-ratio: auto;
    height: 82vh;
  }
  .app__poster {
    position: absolute;
    inset: 0;
  }
  .app__poster[hidden] {
    display: none;
  }
  .app__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .app__open {
    position: absolute;
    left: 50%;
    bottom: 1.2rem;
    transform: translateX(-50%);
  }
  .app__note {
    position: absolute;
    left: 50%;
    bottom: 4.4rem;
    transform: translateX(-50%);
    background: var(--glass);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .app__bar b {
      font-size: 0.82rem;
    }
  }
</style>
